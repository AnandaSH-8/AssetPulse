# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_supabase_project_ref_here

# Creator (admin) email is NOT a frontend variable. It lives only as the
# CREATOR_EMAIL edge-function secret; the UI uses the `is_creator` flag returned
# by the admin-settings function.

# Demo account credentials — pre-filled on the sign-in form and used to gate
# demo read-only mode. Non-secret (RLS protects the data), but kept out of
# source so they can be changed per deployment. Leave unset to disable the demo
# prefill entirely. The backend needs a matching DEMO_EMAIL edge-function secret.
VITE_DEMO_EMAIL=demo@example.com
VITE_DEMO_PASSWORD=change_me
