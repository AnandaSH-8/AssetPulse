# ===========================================================================
# DEPLOYMENT (Vercel / AWS / any static host)
# ---------------------------------------------------------------------------
# ONLY the VITE_ variables below are needed by the hosting provider.
# Every server-side secret lives in Supabase (Edge Function secrets) and is
# read there at runtime — never add them to your host's environment.
# ===========================================================================

# ---------------------------------------------------------------------------
# Browser settings (inlined into the JS bundle by Vite — publishable by design)
# ---------------------------------------------------------------------------

# Supabase project
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PROJECT_ID=your_supabase_project_ref_here

# Public demo account shown on the sign-in page (leave blank to disable auto-fill)
VITE_DEMO_EMAIL=demo@example.com
VITE_DEMO_PASSWORD=change_me

# ---------------------------------------------------------------------------
# Server-only secrets — REFERENCE ONLY. NOT required on Vercel/AWS.
# Do NOT put real values here and never prefix them with VITE_.
# Set these in Supabase: Project Settings > Edge Functions > Secrets.
# ---------------------------------------------------------------------------

# Key used to encrypt/decrypt monetary values at rest (any long random string)
# AMOUNT_ENCRYPTION_KEY=long_random_secret_here

# Email of the app owner — unlocks creator-only admin actions
# CREATOR_EMAIL=owner@example.com

# Demo account email, used server-side to enforce read-only demo mode
# DEMO_EMAIL=demo@example.com

# Injected automatically by Supabase inside Edge Functions — never set manually
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
# SUPABASE_SECRET_KEY=your_supabase_secret_key_here
